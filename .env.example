# Supabase (required for auth, database, and storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Prefer either classic anon key or the newer publishable key from the dashboard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: service role key — server-only, never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: CLI access for `supabase link` / `db push` without interactive login.
# SUPABASE_ACCESS_TOKEN=sbp_...

# Transactional Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Instagram Platform API OAuth Connection (@barbod.barber.hu)
INSTAGRAM_APP_ID=1859392048774076
INSTAGRAM_APP_SECRET=70f311296addee4bd3419e9d5c1ee969
INSTAGRAM_ENCRYPTION_SECRET=5e3dcc19e8d709ff6e141b2ea87d0bbcf1b805deb79ceca4cfba9ecb1fadc8e5
# Optional canonical redirect URI override (defaults to https://${VERCEL_URL}/api/auth/instagram/callback)
# INSTAGRAM_REDIRECT_URI=https://barbod-gold.vercel.app/api/auth/instagram/callback


